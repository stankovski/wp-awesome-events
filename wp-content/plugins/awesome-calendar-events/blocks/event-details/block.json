{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "awesome-calendar-events/event-details",
	"title": "Event Details",
	"description": "Container that displays a single event inside a calendar date cell.",
	"category": "awesome-calendar-events",
	"icon": "megaphone",
	"keywords": [ "event", "details", "calendar", "container" ],
	"textdomain": "awesome-calendar-events",
	"editorScript": "awesome-calendar-events-event-details-editor",
	"style": "awesome-calendar-events-calendar-style",
	"usesContext": [ "awesome-calendar-events/event" ],
	"parent": [ "awesome-calendar-events/calendar-date" ],
	"attributes": {
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"titleTag": {
			"type": "string",
			"enum": [ "h2", "h3", "h4", "h5", "p", "div" ],
			"default": "h3"
		},
		"linkTitle": {
			"type": "boolean",
			"default": true
		},
		"showTime": {
			"type": "boolean",
			"default": true
		},
		"showLocation": {
			"type": "boolean",
			"default": false
		},
		"showSnippet": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"className": true,
		"color": {
			"gradients": true,
			"link": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	}
}
